                  "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Identity",
      "description": "Session-cookie endpoints use SESSION_COOKIE_SECURE when explicitly configured, otherwise the effective HTTPS request scheme controls the Secure attribute. Cookies persist for SESSION_MAX_AGE_SECONDS (default 604800; 0 creates a browser-session cookie). Behind CloudFront or an ALB, keep ENABLE_PROXY_HEADERS=true, configure TRUSTED_PROXY_IPS for trusted upstreams, and use COGNITO_SSL_VERIFY=true outside controlled local troubleshooting.",
      "item": [
        {
          "name": "GET /v1/whoami",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{base_url}}/v1/whoami"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('whoami has core keys', function () {",
                  "  pm.expect(body).to.have.property('storage_policy');",
                  "  pm.expect(body).to.have.property('baseline');",
                  "  pm.expect(body).to.have.property('rate_limits');",
                  "  pm.expect(body).to.have.property('breakers');",
                  "  pm.expect(body).to.have.property('plan_tier');",
                  "  if (body.billing) { pm.expect(body.billing).to.have.property('plan_code'); }",
                  "});",
                  "if (body.user_id) { pm.collectionVariables.set('user_id', body.user_id); }",
                  "if (body.api_key_id) { pm.collectionVariables.set('api_key_id', body.api_key_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/entitlements",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{base_url}}/v1/entitlements",
            "description": "Returns the server-resolved plan, lifecycle state, features, model billing classes, server-owned file limits, current period, and all seven allowance counters. BILLING_ENABLED=false resolves Free without Stripe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('entitlements response shape', function () {",
                  "  pm.expect(body).to.have.property('plan');",
                  "  pm.expect(body).to.have.property('features');",
                  "  pm.expect(body).to.have.property('model_access');",
                  "  pm.expect(body).to.have.property('limits');",
                  "  pm.expect(body.limits.max_files_per_request).to.be.above(0);",
                  "  pm.expect(body.limits.max_file_bytes).to.be.above(0);",
                  "  pm.expect(body).to.have.property('allowances');",
                  "  pm.expect(body).to.have.property('period');",
                  "  pm.expect(Object.keys(body.allowances)).to.have.lengthOf(7);",
                  "  Object.keys(body.allowances).forEach(function (meter) { pm.expect(body.allowances[meter].remaining).to.be.at.least(0); });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/auth/dev-login (local-only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-Login-Token",
                "value": "{{dev_login_token}}",
                "disabled": true
              }
            ],
            "url": "{{base_url}}/v1/auth/dev-login",
            "description": "Local-development helper. Enabled only when ENABLE_DEV_SESSION_LOGIN=true and blocked in production-like envs. On success, the cortex_session cookie follows SESSION_COOKIE_SECURE and SESSION_MAX_AGE_SECONDS."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200/401/403/404 based on env guards', function () {",
                  "  pm.expect([200, 401, 403, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  var setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "  pm.test('sets cortex_session cookie', function () { pm.expect(setCookie).to.include('cortex_session='); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "GET /v1/billing/plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/v1/billing/plans",
            "description": "Public display-safe Free/Plus/Pro catalogue. Returns server-owned USD prices, feature/model access, core allowances, and boolean billing_enabled without Stripe Price IDs, Customers, secrets, or provider objects."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('display-safe plans response shape', function () {",
                  "  pm.expect(body.currency).to.eql('USD');",
                  "  pm.expect(body.billing_period).to.eql('monthly');",
                  "  pm.expect(body.billing_enabled).to.be.a('boolean');",
                  "  pm.expect(body.plans).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(JSON.stringify(body).toLowerCase()).not.to.include('price_id');",
                  "  pm.expect(JSON.stringify(body).toLowerCase()).not.to.include('customer');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/billing/subscription",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": "{{base_url}}/v1/billing/subscription",
            "description": "Returns the authenticated user's effective provider-safe plan/status, current period, cancellation state, and manage capability. Provider subscription IDs are never returned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status reflects subscription or runtime auth/database requirements', function () { pm.expect([200, 401, 403, 501]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) {",
                  "  var body = pm.response.json();",
                  "  pm.test('provider-safe subscription shape', function () {",
                  "    pm.expect(body.plan_code).to.be.a('string');",
                  "    pm.expect(body.status).to.be.a('string');",
                  "    pm.expect(body.can_manage).to.be.a('boolean');",
                  "    pm.expect(body).not.to.have.property('provider_subscription_id');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/billing/checkout-session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_code\": \"plus\",\n  \"billing_period\": \"monthly\"\n}"
            },
            "url": "{{base_url}}/v1/billing/checkout-session",
            "description": "Creates a server-owned Stripe Checkout URL. Existing provider-live subscribers receive a Portal destination instead. Never add Price, amount, Customer, or redirect fields to this request. Use Stripe test mode; BILLING_ENABLED=false returns 503."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status reflects checkout, customer state, or disabled billing', function () { pm.expect([200, 409, 503]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) {",
                  "  var body = pm.response.json();",
                  "  pm.test('hosted billing redirect shape', function () {",
                  "    pm.expect(body.checkout_url).to.be.a('string');",
                  "    pm.expect(['checkout', 'portal']).to.include(body.destination);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/billing/portal-session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{base_url}}/v1/billing/portal-session",
            "description": "Creates a short-lived Portal URL for the persisted Stripe Customer. Customer ID and return URL are server-owned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status reflects portal, missing customer, or disabled billing', function () { pm.expect([200, 409, 503]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) { pm.test('portal response shape', function () { pm.expect(pm.response.json().portal_url).to.be.a('string'); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/billing/webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Stripe-Signature",
                "value": "{{stripe_signature}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_replace_with_captured_test_event\",\n  \"object\": \"event\",\n  \"type\": \"customer.subscription.updated\",\n  \"created\": 0,\n  \"data\": {\n    \"object\": {}\n  }\n}"
            },
            "url": "{{base_url}}/v1/billing/webhook",
            "description": "Stripe-only callback. Replace the body with the exact raw bytes of a captured test-mode event and set stripe_signature to its matching Stripe-Signature header. Never store STRIPE_WEBHOOK_SECRET or a live payload in this collection. Invalid signatures return 400; BILLING_ENABLED=false returns 503."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status reflects valid delivery, invalid signature, payload guard, processing retry, database mode, or disabled billing', function () { pm.expect([200, 400, 413, 500, 501, 503]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) { pm.test('webhook acknowledgement shape', function () { pm.expect(pm.response.json()).to.eql({ received: true }); }); }",
                  "if (pm.response.code === 400) { pm.test('invalid signature is structured', function () { pm.expect(pm.response.json().detail.code).to.eql('invalid_webhook_signature'); }); }"
                ]
              }
            }
          ]
        }
      ]
    },
