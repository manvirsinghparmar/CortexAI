    {
      "name": "Files",
      "item": [
        {
          "name": "POST /v1/files/upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "X-File-Name",
                "value": "postman-upload.txt"
              },
              {
                "key": "X-File-Content-Type",
                "value": "text/plain"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "Postman file upload probe."
            },
            "url": "{{base_url}}/v1/files/upload"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status reflects upload, auth, feature, or subscription outcome', function () {",
                  "  pm.expect([200, 401, 403, 404, 429, 501]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  var body = pm.response.json();",
                  "  pm.test('file upload response has file_id', function () {",
                  "    pm.expect(body.file_id).to.be.a('string');",
                  "  });",
                  "  pm.collectionVariables.set('file_id', body.file_id);",
                  "} else if ([403, 429].includes(pm.response.code)) {",
                  "  var denial = pm.response.json().detail;",
                  "  pm.test('subscription denial is structured', function () {",
                  "    pm.expect(denial.code).to.be.a('string');",
                  "    pm.expect(denial.message).to.be.a('string');",
                  "    pm.expect(denial.current_plan).to.be.a('string');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
