              "raw": "{\n  \"source\": \"postman\",\n  \"reason\": \"manual-check\",\n  \"page_instance_id\": \"postman-page\",\n  \"events\": [\n    {\n      \"event\": \"boot\",\n      \"timestamp\": \"2026-07-04T00:00:00.000Z\",\n      \"page_instance_id\": \"postman-page\",\n      \"details\": {\n        \"navigationType\": \"navigate\",\n        \"wasDiscarded\": false\n      }\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/v1/client-diagnostics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
