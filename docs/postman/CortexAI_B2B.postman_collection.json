      "key": "api_key",
      "value": "dev-key-1"
    },
    {
      "key": "bearer_token",
      "value": ""
    },
    {
      "key": "dev_login_token",
      "value": ""
    },
    {
      "key": "chat_provider",
      "value": "openai"
    },
