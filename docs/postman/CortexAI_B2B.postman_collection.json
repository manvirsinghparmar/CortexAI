{
  "info": {
    "name": "CortexAI B2B API (Complete)",
    "description": "Postman collection for CortexAI API-first contract validation: health/runtime diagnostics, browser lifecycle diagnostics, effective subscription entitlements, catalog discovery, file upload/status, chat/compare (sync + streaming), BYOK, history, reporting/exports, optimize, and admin diagnostics. DATABASE_URL is required at API startup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "api_key",
      "value": "dev-key-1"
    },
    {
      "key": "bearer_token",
      "value": ""
    },
    {
      "key": "dev_login_token",
      "value": ""
    },
    {
      "key": "chat_provider",
      "value": "openai"
    },
    {
      "key": "chat_model",
      "value": "gpt-4o-mini"
    },
    {
      "key": "compare_provider",
      "value": "gemini"
    },
    {
      "key": "compare_model",
      "value": "gemini-2.5-flash-lite"
    },
    {
      "key": "request_group_id",
      "value": ""
    },
    {
      "key": "history_entry_id",
      "value": "1"
    },
    {
      "key": "session_id",
      "value": ""
