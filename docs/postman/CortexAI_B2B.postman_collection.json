{
  "info": {
    "name": "CortexAI B2B API (Complete)",
    "description": "Postman collection for CortexAI API-first contract validation: health/runtime diagnostics, catalog discovery, file upload/status, chat/compare (sync + streaming), BYOK, history, reporting/exports, optimize, and admin diagnostics. DATABASE_URL is required at API startup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "api_key",
      "value": "dev-key-1"
    },
    {
      "key": "chat_provider",
      "value": "openai"
    },
    {
      "key": "chat_model",
      "value": "gpt-4o-mini"
    },
    {
      "key": "compare_provider",
      "value": "gemini"
    },
    {
      "key": "compare_model",
      "value": "gemini-2.5-flash-lite"
    },
    {
      "key": "request_group_id",
      "value": ""
    },
    {
      "key": "history_entry_id",
      "value": "1"
    },
    {
      "key": "byok_openai_key",
      "value": "sk-tenant-openai-example-1234"
    },
    {
      "key": "from_date",
      "value": "2026-02-01"
    },
    {
      "key": "to_date",
      "value": "2026-02-22"
    },
    {
      "key": "provider_filter",
      "value": "openai"
    },
    {
      "key": "file_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('healthy status', function () { pm.expect(body.status).to.eql('healthy'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /health/runtime",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health/runtime"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('runtime health has status + claude diagnostics', function () {",
                  "  pm.expect(body).to.have.property('status');",
                  "  pm.expect(body).to.have.property('python_executable');",
                  "  pm.expect(body).to.have.property('claude');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Identity",
      "item": [
        {
          "name": "GET /v1/whoami",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{base_url}}/v1/whoami"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('whoami has core keys', function () {",
                  "  pm.expect(body).to.have.property('storage_policy');",
                  "  pm.expect(body).to.have.property('baseline');",
                  "  pm.expect(body).to.have.property('rate_limits');",
                  "  pm.expect(body).to.have.property('breakers');",
                  "});",
                  "if (body.user_id) { pm.collectionVariables.set('user_id', body.user_id); }",
                  "if (body.api_key_id) { pm.collectionVariables.set('api_key_id', body.api_key_id); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "GET /v1/providers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{base_url}}/v1/providers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('providers response shape', function () {",
                  "  pm.expect(body.providers).to.be.an('array');",
                  "  pm.expect(body.total).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/models",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{base_url}}/v1/models?provider={{provider_filter}}&enabled_only=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('models response shape', function () {",
                  "  pm.expect(body.models).to.be.an('array');",
                  "  pm.expect(body.enabled_only).to.eql(true);",
                  "  if (body.models.length > 0) {",
                  "    pm.expect(body.models[0]).to.have.property('supports_image_input');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "POST /v1/files/upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "X-File-Name",
                "value": "postman-upload.txt"
              },
              {
                "key": "X-File-Content-Type",
                "value": "text/plain"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "Postman file upload probe."
            },
            "url": "{{base_url}}/v1/files/upload"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 404 (attachments disabled)', function () {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  var body = pm.response.json();",
                  "  pm.test('file upload response has file_id', function () {",
                  "    pm.expect(body.file_id).to.be.a('string');",
                  "  });",
                  "  pm.collectionVariables.set('file_id', body.file_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/files/{file_id}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
