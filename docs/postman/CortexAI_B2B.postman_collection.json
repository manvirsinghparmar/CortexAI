    {
      "name": "History",
      "item": [
        {
          "name": "GET /v1/history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": "{{base_url}}/v1/history?limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 501 (legacy compatibility)', function () {",
                  "  pm.expect([200, 501]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  var body = pm.response.json();",
                  "  pm.test('history is an array', function () { pm.expect(body).to.be.an('array'); });",
                  "  if (body.length > 0) {",
                  "    pm.test('history exposes session and compare grouping fields', function () {",
                  "      pm.expect(body[0]).to.have.property('session_id');",
                  "      pm.expect(body[0]).to.have.property('session_title');",
                  "      pm.expect(body[0]).to.have.property('request_group_id');",
                  "    });",
                  "  }",
                  "  if (body.length > 0 && body[0].id) { pm.collectionVariables.set('history_entry_id', String(body[0].id)); }",
                  "  if (body.length > 0 && body[0].session_id) { pm.collectionVariables.set('session_id', String(body[0].session_id)); }",
                  "}"
                ]
              }
            }
          ]
        },
