# ============================================
# Component boundary controls
# ============================================
SERVE_FRONTEND=true
FRONTEND_DIR=frontend

# ============================================
# Provider and model selection
# ============================================
MODEL_TYPE=openai

OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_OPENAI_MODEL=gpt-4o-mini

GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
DEFAULT_GEMINI_MODEL=gemini-2.5-flash-lite

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEFAULT_DEEPSEEK_MODEL=deepseek-chat

GROK_API_KEY=your_grok_api_key_here

# Claude API Configuration (required if MODEL_TYPE=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Amazon Cognito (Gmail / Google sign-in)
# Optional. When set, frontend can use "Sign in with Google"; API accepts Bearer ID token or X-API-Key.
COGNITO_USER_POOL_ID=us-east-1_DUh9AR9JK
COGNITO_CLIENT_ID=5i9cjes5hpui0okrfi656jk3ss
COGNITO_REGION=us-east-1
COGNITO_DOMAIN=https://us-east-1duh9ar9jk.auth.us-east-1.amazoncognito.com
# Callback URL for authorization code flow (must match Cognito app client). If unset, uses request base + /v1/auth/callback.
COGNITO_REDIRECT_URI=https://your-domain.com/v1/auth/callback
# Required for token exchange if app client has a secret
# COGNITO_CLIENT_SECRET=
# Where to redirect after successful login (default /index.html). Use full URL if frontend is on another origin (e.g. CloudFront).
# COGNITO_SUCCESS_REDIRECT_URI=https://d25xyr8ffdpyvr.cloudfront.net/index.html

# Tavily API Configuration (required for Web mode in frontend)
TAVILY_API_KEY=your_tavily_api_key_here

# For Grok models (e.g., grok-4-latest)
# grok-4-latest: Latest Grok model with advanced reasoning capabilities
DEFAULT_GROK_MODEL=grok-4-latest

ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_CLAUDE_MODEL=claude-sonnet-4-5

# ============================================
# Chat/routing/logging behavior
# ============================================
MAX_CONTEXT_MESSAGES=20
COMPARE_MODE=false
RESEARCH_MODE=auto
ROUTING_MODE=smart
ROUTING_DEBUG_JSON=false

LOG_LEVEL=INFO
LOG_TO_CONSOLE=false
ROUTING_DEBUG=false
ENABLE_BROWSE_DISCLAIMER_CHECK=false
ENABLE_FABRICATION_CHECK=false

# ============================================
# API key auth + unmapped-key persistence policy
# ============================================
API_KEYS=dev-key-1,dev-key-2
AUTO_REGISTER_UNMAPPED_API_KEYS=false
ALLOW_UNMAPPED_API_KEY_PERSIST=false
API_KEY_FALLBACK_USER_EMAIL=api@cortexai.local
API_KEY_FALLBACK_USER_NAME=API Service User

# ============================================
# Web research + prompt optimization
# ============================================
TAVILY_API_KEY=your_tavily_api_key_here
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_TTL_SECONDS=900

ENABLE_PROMPT_OPTIMIZATION=false
PROMPT_OPTIMIZER_PROVIDER=gemini
PROMPT_OPTIMIZER_MODEL=gpt-4o-mini
PROMPT_OPTIMIZER_GEMINI_MODEL=gemini-2.5-flash-lite
PROMPT_OPTIMIZER_MAX_RETRIES=3

# ============================================
# PostgreSQL runtime
# ============================================
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cortexai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_SCHEMA=public

# ============================================
# Attachments / object storage
# ============================================
ENABLE_ATTACHMENTS=false
ATTACHMENTS_OBJECT_STORAGE_BACKEND=s3
ATTACHMENTS_S3_BUCKET=your-bucket-name
ATTACHMENTS_S3_REGION=us-east-1
ATTACHMENTS_S3_ENDPOINT_URL=
ATTACHMENTS_S3_ACCESS_KEY_ID=
ATTACHMENTS_S3_SECRET_ACCESS_KEY=
ATTACHMENTS_S3_USE_SSL=true
ATTACHMENTS_S3_FORCE_PATH_STYLE=true
ATTACHMENTS_S3_KEY_PREFIX=attachments
