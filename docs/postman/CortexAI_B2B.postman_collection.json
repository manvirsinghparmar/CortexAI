              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('healthy status', function () { pm.expect(body.status).to.eql('healthy'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /health/runtime",
          "request": {
