E2E_LIVE_ENABLED=true
E2E_HOST=127.0.0.1
E2E_PORT=8010
E2E_BASE_URL=http://127.0.0.1:8010
E2E_API_KEY=dev-key-1
E2E_DEV_SESSION_LOGIN_TOKEN=cortex-e2e-dev-login
E2E_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
E2E_DB_SCHEMA=public
E2E_LOAD_ROOT_DOTENV=true
E2E_ENABLE_FAULT_INJECTION=true
E2E_SERVER_START_TIMEOUT_MS=90000
E2E_DISCOVERY_TIMEOUT_MS=30000
E2E_FRONTEND_READY_TIMEOUT_MS=30000
E2E_FIRST_CONTENT_TIMEOUT_MS=45000
E2E_ASK_TIMEOUT_MS=180000
E2E_COMPARE_TIMEOUT_MS=240000
E2E_HISTORY_RESTORE_TIMEOUT_MS=20000
E2E_FALLBACK_TIMEOUT_MS=120000
