              "raw": "{\n  \"prompt\": \"Improve this prompt for clarity and structure.\"\n}"
            },
            "url": "{{base_url}}/v1/optimize"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('optimize response schema', function () {",
                  "  pm.expect(body).to.have.property('original_prompt');",
                  "  pm.expect(body).to.have.property('optimized_prompt');",
                  "  pm.expect(body).to.have.property('was_optimized');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
