    {
      "name": "Chat",
      "item": [
        {
          "name": "POST /v1/chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Postman B2B e2e chat probe\",\n  \"provider\": \"{{chat_provider}}\",\n  \"model\": \"{{chat_model}}\",\n  \"routing\": {\n    \"smart_mode\": false,\n    \"research_mode\": false\n  }\n}"
            },
            "url": "{{base_url}}/v1/chat",
            "description": "DB-mode Ask resolves the effective plan and server-owned model billing class, then reserves model/research units before provider execution. Entitlement denial is 403, exhausted monthly allowance is 429, and unsafe billing configuration is 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is success, auth, or structured subscription denial', function () {",
                  "  pm.expect([200, 401, 402, 403, 429, 500]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code !== 200) {",
                  "  if (pm.response.code !== 401) { pm.expect(pm.response.json().detail.code).to.be.a('string'); }",
                  "  return;",
                  "}",
                  "var body = pm.response.json();",
                  "pm.test('chat response has request_id/provider/model', function () {",
                  "  pm.expect(body.request_id).to.be.a('string');",
                  "  pm.expect(body.provider).to.be.a('string');",
                  "  pm.expect(body.model).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/chat/stream",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/x-ndjson"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Postman B2B e2e chat stream probe\",\n  \"provider\": \"{{chat_provider}}\",\n  \"model\": \"{{chat_model}}\"\n}"
            },
            "url": "{{base_url}}/v1/chat/stream",
            "description": "Reserves Ask subscription usage before returning the NDJSON stream. Provider failure releases response units; successful model/research usage is finalized before terminal response events."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is success, auth, or structured subscription denial', function () {",
                  "  pm.expect([200, 401, 402, 403, 429, 500]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code !== 200) {",
                  "  if (pm.response.code !== 401) { pm.expect(pm.response.json().detail.code).to.be.a('string'); }",
                  "  return;",
                  "}",
                  "var text = pm.response.text();",
                  "pm.test('stream includes start and done markers', function () {",
                  "  pm.expect(text).to.include('\\\"type\\\": \\\"start\\\"');",
                  "  pm.expect(text).to.include('\\\"type\\\": \\\"done\\\"');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Compare",
      "item": [
        {
          "name": "POST /v1/compare",
          "request": {
            "method": "POST",
            "header": [
