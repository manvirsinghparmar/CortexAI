{
  "name": "cortexai-live-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install chromium",
    "mcp": "npx @playwright/mcp@latest --browser chromium --isolated --output-dir .runtime/mcp",
    "mcp:headless": "npx @playwright/mcp@latest --browser chromium --headless --isolated --output-dir .runtime/mcp",
    "mcp:sse": "npx @playwright/mcp@latest --browser chromium --headless --isolated --output-dir .runtime/mcp --host 127.0.0.1 --port 8931"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
